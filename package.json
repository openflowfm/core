    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@openflow/protocol": "github:openflowfm/protocol#137a9794b7f6d4148326970e5de6011cfee84902"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
